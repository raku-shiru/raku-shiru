---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import {getCollection} from 'astro:content';
import {categoryIds,categories,categoryUrl} from '../../lib/site';
export async function getStaticPaths(){return categoryIds.map(id=>({params:{id}}));}
const id = Astro.params.id as keyof typeof categories;
const category = categories[id];
const posts=(await getCollection('blog')).filter(post=>post.data.category===id).sort((a,b)=>b.data.publishedAt.getTime()-a.data.publishedAt.getTime());
---
<BaseLayout title={category.title} description={`${category.intro} ラクしるの${category.title}関連記事をまとめました。`}>
  <div class="shell"><Breadcrumb items={[{label:'記事一覧',href:'/articles/'},{label:category.title}]}/></div>
  <header class="page-head"><div class="shell"><div class="eyebrow">Category / {category.number}</div><h1>{category.title}</h1><p>{category.intro}</p></div></header>
  <section class="page-content"><div class="shell"><div class="section-head"><h2 style="margin:0">このテーマの記事</h2><span class="eyebrow">{posts.length} articles</span></div><div class="article-grid article-grid--two">{posts.map((post,i)=><ArticleCard post={post} index={i+1}/>)}</div><p style="margin-top:45px"><a class="text-link" href="/articles/">← すべての記事へ</a></p></div></section>
</BaseLayout>
