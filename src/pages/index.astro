---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { categories,categoryIds,categoryUrl } from '../lib/site';
const posts = (await getCollection('blog')).sort((a,b)=>b.data.publishedAt.getTime()-a.data.publishedAt.getTime());
const featured = posts.find(p=>p.data.featured) ?? posts[0];
const rest = posts.filter(p=>p.id !== featured?.id);
---
<BaseLayout>
  <section class="hero"><div class="shell hero-layout">
    <div><div class="hero-tag">RAKUSHIRU • 暮らしのヒント</div><h1>毎日の暮らしを、<br /><em>もっとラクに。</em></h1><p class="hero-copy">家事も、ごはんも、いつものことも。<br />ちょっとした工夫や便利なサービスを知るだけで、毎日が少し軽くなるかもしれません。</p><a href="/articles/" class="button button--primary">記事を読んでみる<span aria-hidden="true">↗</span></a></div>
    <div class="hero-art" aria-hidden="true">
      <div class="hero-orbit-ring"></div>
      <div class="hero-orbit-track">
        <span class="hero-orbit-pill hero-orbit-pill--top">なるほど、が見つかる</span>
        <span class="hero-orbit-pill hero-orbit-pill--bottom">ゆとりのある毎日へ</span>
      </div>
      <div class="hero-emblem"><img src="/favicon.svg" width="230" height="230" alt="" /></div>
    </div>
  </div></section>
  <div class="stat-ribbon"><div class="shell"><strong>毎日の「ちょっと困った」を、暮らしのヒントに。</strong><span>TIME-SAVING IDEAS / EVERYDAY SERVICES / GENTLE CHOICES</span></div></div>
  <section class="section"><div class="shell"><div class="section-head"><div><div class="eyebrow">Editor's pick</div><h2>まず、読んでほしい記事</h2></div><a href="/articles/" class="text-link">すべての記事を見る <span aria-hidden="true">↗</span></a></div><div class="featured-grid">{featured && <ArticleCard post={featured} index={1} featured/>}<div style="display:grid;gap:20px">{rest.slice(0,2).map((post,i)=><ArticleCard post={post} index={i+2}/>)}</div></div></div></section>
  <section class="section section--soft"><div class="shell"><div class="section-head"><div><div class="eyebrow">Explore by topic</div><h2>気になることから、探してみる。</h2></div></div><div class="category-grid">{categoryIds.map(id=><a href={categoryUrl(id)} class="category-tile"><span class="category-tile__num">{categories[id].number} / CATEGORY</span><span class="category-tile__icon" aria-hidden="true">{id==='meal'?'食':id==='housework'?'家':id==='cleaning'?'整':id==='grooming'?'身':id==='tea'?'茶':id==='deals'?'得':id==='kitchen'?'鍋':'時'}</span><h3>{categories[id].title}</h3><p>{categories[id].short} <span aria-hidden="true">↗</span></p></a>)}</div></div></section>
  <section class="section"><div class="shell"><div class="section-head"><div><div class="eyebrow">New articles</div><h2>新着の記事</h2></div><a href="/articles/" class="text-link">記事一覧 <span aria-hidden="true">↗</span></a></div><div class="article-grid">{posts.slice(0,3).map((post,i)=><ArticleCard post={post} index={i+1}/>)}</div></div></section>
  <section class="section section--soft"><div class="shell manifesto"><div><div class="eyebrow">A little about us</div><h2>がんばりすぎない、<br />暮らしの選び方。</h2><p>便利なものが増えた今だからこそ、本当に自分に合うかどうかを大切に。ラクしるは、いいところだけでなく、気をつけたいことも、わかりやすくお届けします。</p><a href="/about/" class="text-link">ラクしるについて <span aria-hidden="true">↗</span></a></div><div class="manifesto-panel"><blockquote>できることは、自分で。<br />頼れるところは、<br />上手に頼って。</blockquote><cite>ラクしるの考える、暮らしのゆとり。</cite></div></div></section>
</BaseLayout>
