---
import '../styles/global.css';
import BrandMark from '../components/BrandMark.astro';
import { SITE_NAME, SITE_TAGLINE, SITE_DESCRIPTION, categories, categoryIds } from '../lib/site';
interface Props {
  title?: string;
  description?: string;
  type?: 'website'|'article';
  noindex?: boolean;
  jsonLd?: Record<string,unknown>|Record<string,unknown>[];
}
const {title=SITE_NAME,description=SITE_DESCRIPTION,type='website',noindex=false,jsonLd}=Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://rakushiru.pages.dev').toString();
const fullTitle=title===SITE_NAME?`${SITE_NAME}｜${SITE_TAGLINE}`:`${title}｜${SITE_NAME}`;
const siteUrl=(Astro.site ?? new URL('https://rakushiru.pages.dev')).toString();
const jsonNodes=[{ '@context':'https://schema.org', '@type':'WebSite', name:SITE_NAME, url:siteUrl, inLanguage:'ja-JP',description:SITE_DESCRIPTION },...(jsonLd?Array.isArray(jsonLd)?jsonLd:[jsonLd]:[])];
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim() || '';
const safeJson=JSON.stringify(jsonNodes).replace(/</g,'\\u003c');
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="color-scheme" content="light" />
  <meta name="format-detection" content="telephone=no" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
  <meta name="robots" content={noindex?'noindex,follow':'index,follow,max-image-preview:large'} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/favicon.svg" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/og-default.svg',Astro.site ?? 'https://rakushiru.pages.dev').toString()} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={safeJson} />
</head>
<body>
  <a class="skip-link" href="#main-content">本文へ移動</a>
  <header class="site-header">
    <div class="shell header-inner">
      <a href="/" class="brand" aria-label="ラクしる ホーム"><BrandMark size={42}/><span class="brand__text">ラクしる<span class="brand__dot">.</span></span></a>
      <nav class="nav-desktop" aria-label="メインナビゲーション">
        <a href="/articles/">記事をさがす</a><a href="/categories/meal/">食事</a><a href="/categories/housework/">家事</a><a href="/categories/cleaning/">掃除</a><a href="/categories/subscriptions/">サブスク</a>
      </nav>
      <a href="/about/" class="header-about">ラクしるについて <span aria-hidden="true">↗</span></a>
      <details class="mobile-nav"><summary aria-label="メニューを開く"><span></span><span></span><span class="sr-only">メニュー</span></summary><nav aria-label="モバイルナビゲーション"><a href="/articles/">記事をさがす</a>{categoryIds.map(id=><a href={`/categories/${id}/`}>{categories[id].title}</a>)}<a href="/about/">ラクしるについて</a></nav></details>
    </div>
  </header>
  <main id="main-content"><slot /></main>
  <footer class="site-footer">
    <div class="shell footer-main">
      <div class="footer-intro"><a class="footer-brand" href="/"><BrandMark size={43}/> <span>ラクしる</span></a><p>毎日の暮らしを、もっとラクに。</p><small>選ぶ前に、知っておきたいことを。</small></div>
      <div class="footer-links"><div><strong>記事を読む</strong><a href="/articles/">すべての記事</a>{categoryIds.map(id=><a href={`/categories/${id}/`}>{categories[id].title}</a>)}</div><div><strong>サイトについて</strong><a href="/about/">ラクしるについて</a><a href="/operator/">運営者情報</a><a href="/editorial-policy/">編集方針</a><a href="/advertising-policy/">広告掲載ポリシー</a><a href="/privacy/">プライバシーポリシー</a><a href="/contact/">お問い合わせ</a></div></div>
    </div>
    <div class="shell footer-bottom"><span>© {new Date().getFullYear()} ラクしる</span><span>Good days, with a little less effort.</span></div>
  </footer>
</body>
</html>
