---
interface Item { label:string;href?:string }
interface Props { items:Item[] }
const {items}=Astro.props;
---
<nav aria-label="パンくずリスト" class="breadcrumbs"><ol><li><a href="/">ホーム</a></li>{items.map(item=><li><span aria-hidden="true">/</span>{item.href?<a href={item.href}>{item.label}</a>:<span aria-current="page">{item.label}</span>}</li>)}</ol></nav>
