---
interface Props { caption:string; headers:string[]; rows:string[][] }
const {caption,headers,rows}=Astro.props;
---
<div class="table-scroll" tabindex="0" role="region" aria-label={caption}><table><caption>{caption}</caption><thead><tr>{headers.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{rows.map(row=><tr>{row.map((cell,i)=>i===0?<th scope="row">{cell}</th>:<td>{cell}</td>)}</tr>)}</tbody></table></div>
